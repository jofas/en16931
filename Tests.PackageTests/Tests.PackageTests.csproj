<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Tests.PackageTests</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <En16931Version>
      $([System.Text.RegularExpressions.Regex]::new("<Version>(?'version'[0-9]+\.[0-9]+\.[0-9]+)</Version>").Match($([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)\..\En16931\En16931.csproj"))).Groups["version"].Value)
    </En16931Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="En16931" Version="$(En16931Version)" />
    <!-- Transient dependency of En16931 through SaxonCS-HE; added here to avoid vulnerability warnings -->
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <!-- Transient dependency of En16931 through SaxonCS-HE; added here to avoid vulnerability warnings -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
