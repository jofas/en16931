<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Build</PackageId>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transient dependency of SaxonCS-HE; added here to avoid vulnerability warnings -->
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="SaxonCS-HE" Version="13.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <!-- Transient dependency of SaxonCS-HE; added here to avoid vulnerability warnings -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
