<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>En16931</PackageId>
    <Version>0.1.0</Version>
    <Authors>Jonas Fassbender</Authors>
    <Company>fassbender.dev</Company>

    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SaxonCS-HE" Version="13.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\En16931.Resources.Extern\**\*.*">
      <LogicalName>$([System.String]::new('%(RelativeDir)').Remove(0,3).Replace('\','/'))%(FileName)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\IR\**\*.*">
      <LogicalName>$([System.String]::new('%(RelativeDir)').Remove(0,3).Replace('\','/'))%(FileName)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
