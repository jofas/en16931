<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>En16931</PackageId>
    <Version>0.1.0</Version>
    <Description>.NET implementation of the EN16931:2017 data model and the two mandatory syntaxes.</Description>
    <Authors>Jonas Fassbender</Authors>
    <Company>fassbender.dev</Company>
    <Copyright>Copyright © Jonas Fassbender 2026.</Copyright>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageProjectUrl>https://fassbender.dev/en16931/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jofas/en16931</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SaxonCS-HE" Version="13.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\En16931.Resources.Extern\**\*.*">
      <PackagePath>contentFiles/any/any/En16931.Resources.Extern</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <PackageFlatten>false</PackageFlatten>
    </Content>
    <Content Include="..\IR\**\*.*">
      <PackagePath>contentFiles/any/any/IR</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <PackageFlatten>false</PackageFlatten>
    </Content>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
